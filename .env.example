# --- Claude (the "brain": writes posts, analyzes performance, writes daily report) ---
ANTHROPIC_API_KEY=
# Model used for content generation + daily report. Defaults to claude-opus-5 if unset.
# claude-haiku-4-5 is cheapest ($1/$5 per 1M tokens) and plenty capable for short posts;
# claude-sonnet-5 is a middle ground; claude-opus-5 is highest quality/cost.
CONTENT_MODEL=claude-haiku-4-5

# --- LinkedIn Developer App (linkedin.com/developers/apps) ---
# Create an app -> add the "Share on LinkedIn" and "Sign In with LinkedIn using OpenID Connect" products
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match a redirect URL registered on the app (used once, during setup, to grant access)
LINKEDIN_REDIRECT_URI=http://localhost:8080/auth/linkedin/callback

# --- Server ---
PORT=8080
# Random long string used to sign/encrypt local session state
SESSION_SECRET=change-me-to-a-random-string

# --- Posting behavior ---
# How many days ahead the brain should keep a buffer of drafted+scheduled posts
SCHEDULE_LOOKAHEAD_DAYS=3
# Local time (24h) each day new content is generated to refill the queue
CONTENT_GEN_HOUR=6
# Local time (24h) the daily performance report is compiled
REPORT_HOUR=8
# Posting cadence: comma-separated local HH:MM slots, applied Mon-Fri
POST_TIMES=09:15,16:30

# --- Content pillars (comma-separated, used to seed the brain's topic rotation) ---
CONTENT_PILLARS=career journey and job search,Android/Kotlin development,psychrometrics and HVAC engineering,build-in-public project updates

# --- Where the daily report gets delivered ---
# "console" just logs it; "file" writes to reports/ folder. Email/Slack can be wired in later.
REPORT_CHANNEL=file
